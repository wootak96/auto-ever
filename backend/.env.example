# ─────────────────────────────────────────────────────────────────────────────
#  RAG Chatbot 백엔드 환경변수.
#  복사해서 사용:  cp .env.example .env  →  아래 [필수] 항목 채우기
# ─────────────────────────────────────────────────────────────────────────────

# ───────── [필수] LLM 프로바이더 선택 ─────────
# 테스트용 퍼블릭 OpenAI:  openai
# 운영(사내 게이트웨이):    azure
LLM_PROVIDER=openai

# ───────── [필수] 퍼블릭 OpenAI (LLM_PROVIDER=openai 일 때) ─────────
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# OpenAI 호환 엔드포인트(예: 사내 프록시) 사용 시에만 지정:
# OPENAI_BASE_URL=https://my-proxy.local/v1
OPENAI_BASE_URL=

# ───────── [필수] Elasticsearch 클러스터 ─────────
# 단일 노드:   ES_HOSTS=https://es01.mycorp.io:9200
# 다중 노드:   ES_HOSTS=https://es01.mycorp.io:9200,https://es02.mycorp.io:9200
ES_HOSTS=https://localhost:9200
ES_USERNAME=elastic
ES_PASSWORD=

# 자체 서명 인증서면 false 그대로. 사내 CA 번들이 있으면 ES_CA_CERTS에 경로 + ES_VERIFY_CERTS=true
ES_VERIFY_CERTS=false
ES_CA_CERTS=

# ───────── 사내 LLM (LLM_PROVIDER=azure 일 때) ─────────
# 운영 시점에 채워주세요. 지금은 테스트라 비워둬도 무방.
HCHAT_API_KEY=
# 사내 게이트웨이 주소. 소스에 기본값을 두지 않으므로 azure 사용 시 반드시 지정.
HCHAT_ENDPOINT=https://<your-internal-gateway>/<path>/api/v3
HCHAT_DEPLOYMENT=gpt-5.4-mini
HCHAT_API_VERSION=2024-02-01

# ───────── [선택] 인덱스명 / 필드명 ─────────
# 검색 대상 인덱스 3개 (8차):
#   - elasticsearch_docs / kafka_docs : 영어 공식 docs (BM25/semantic 영어)
#   - confluence_docs                 : 한국어 사내 위키 (BM25/semantic 한국어, 기술용어만 영어)
#   - chat_logs                       : 통합 채팅 로그 (user_id가 keyword 필드, debug_explain이 필터링)
ES_INDEX_ELASTICSEARCH=elasticsearch_docs
ES_INDEX_KAFKA=kafka_docs
ES_INDEX_CONFLUENCE=confluence_docs
ES_INDEX_CHAT_LOGS=chat_logs
ES_FIELD_TITLE=title
ES_FIELD_CONTENT=content
ES_FIELD_SEMANTIC=content_embedding
ES_FIELD_URL=url

# ───────── [선택] 검색 / 대화 파라미터 ─────────
RETRIEVAL_RANK_WINDOW=50
RETRIEVAL_RANK_CONSTANT=60
RETRIEVAL_TOP_K=10
# Retry loop top_k schedule (JSON list). Length = attempt budget.
RETRIEVAL_TOP_K_SCHEDULE=[10,20,30]
MAX_HISTORY_TURNS=5

# ───────── [선택] 브랜딩 / 사내 용어 ─────────
# UI 제목·헤더·인트로와 잡담/일반대화 페르소나에 쓰이는 챗봇 이름.
CHATBOT_NAME=사내 문서 챗봇

# 사내 전용 고유명사 목록 파일. 미지정 시 backend/app/internal_terms.json,
# 그마저 없으면 internal_terms.example.json(플레이스홀더)로 폴백합니다.
# 폴백 상태에서는 사내 고유명사 기반 confluence 강제 라우팅이 동작하지 않습니다.
# INTERNAL_TERMS_FILE=

# ───────── [선택] 서버 ─────────
BACKEND_PORT=8000
LOG_LEVEL=INFO
